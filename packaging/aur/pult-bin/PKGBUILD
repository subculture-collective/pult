# Template: scripts/render-packaging.sh fills the @...@ fields from a release.
pkgname=pult-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Apply one palette across your terminal apps, and undo every change (prebuilt)'
arch=('x86_64' 'aarch64')
url='https://git.subcult.tv/subculture-collective/pult'
license=('GPL-3.0-only' 'MIT')
provides=('pult')
conflicts=('pult')
# The binary is prebuilt and stripped, so a debug package would be empty.
options=('!debug')
source_x86_64=("@BASE@pult-@VERSION@-linux-amd64.tar.gz")
source_aarch64=("@BASE@pult-@VERSION@-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA_LINUX_AMD64@')
sha256sums_aarch64=('@SHA_LINUX_ARM64@')

package() {
  local goarch=amd64
  [[ $CARCH == aarch64 ]] && goarch=arm64
  cd "pult-$pkgver-linux-$goarch"
  install -Dm755 pult "$pkgdir/usr/bin/pult"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSES/MIT.txt "$pkgdir/usr/share/licenses/$pkgname/MIT.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
