# Generated by Pult from {{theme.name}}. Pult replaces this file on every apply.
# Written for Yazi 25.5.28 and later, which use [mgr] instead of [manager].
# Keys and rule syntax follow the catppuccin/yazi port for current Yazi.

[mgr]
cwd = { fg = "{{teal}}" }
find_keyword = { fg = "{{yellow}}", italic = true }
find_position = { fg = "{{pink}}", bg = "reset", italic = true }
marker_copied = { fg = "{{green}}", bg = "{{green}}" }
marker_cut = { fg = "{{red}}", bg = "{{red}}" }
marker_marked = { fg = "{{teal}}", bg = "{{teal}}" }
marker_selected = { fg = "{{blue}}", bg = "{{blue}}" }
count_copied = { fg = "{{base}}", bg = "{{green}}" }
count_cut = { fg = "{{base}}", bg = "{{red}}" }
count_selected = { fg = "{{base}}", bg = "{{blue}}" }
border_symbol = "│"
border_style = { fg = "{{overlay1}}" }

[tabs]
active = { fg = "{{base}}", bg = "{{text}}", bold = true }
inactive = { fg = "{{text}}", bg = "{{surface1}}" }

[mode]
normal_main = { fg = "{{base}}", bg = "{{blue}}", bold = true }
normal_alt = { fg = "{{blue}}", bg = "{{surface0}}" }
select_main = { fg = "{{base}}", bg = "{{green}}", bold = true }
select_alt = { fg = "{{green}}", bg = "{{surface0}}" }
unset_main = { fg = "{{base}}", bg = "{{flamingo}}", bold = true }
unset_alt = { fg = "{{flamingo}}", bg = "{{surface0}}" }

[status]
overall = { fg = "{{text}}", bg = "{{mantle}}" }
progress_label = { fg = "{{text}}", bold = true }
progress_normal = { fg = "{{green}}", bg = "{{surface1}}" }
progress_error = { fg = "{{yellow}}", bg = "{{red}}" }
perm_type = { fg = "{{blue}}" }
perm_read = { fg = "{{yellow}}" }
perm_write = { fg = "{{red}}" }
perm_exec = { fg = "{{green}}" }
perm_sep = { fg = "{{overlay1}}" }

[input]
border = { fg = "{{blue}}" }
selected = { reversed = true }

[pick]
border = { fg = "{{blue}}" }
active = { fg = "{{pink}}" }

[confirm]
border = { fg = "{{blue}}" }
title = { fg = "{{blue}}" }
btn_yes = { reversed = true }

[cmp]
border = { fg = "{{blue}}" }

[tasks]
border = { fg = "{{blue}}" }
hovered = { fg = "{{pink}}", bold = true }

[which]
border = { fg = "{{blue}}" }
cand = { fg = "{{teal}}" }
rest = { fg = "{{overlay2}}" }
desc = { fg = "{{pink}}" }
separator_style = { fg = "{{surface2}}" }

[help]
border = { fg = "{{blue}}" }
chord = { fg = "{{teal}}" }
action = { fg = "{{overlay2}}" }
hovered = { bg = "{{surface2}}", bold = true }

[notify]
title_info = { fg = "{{teal}}" }
title_warn = { fg = "{{yellow}}" }
title_error = { fg = "{{red}}" }

[filetype]
rules = [
  { mime = "**/image/*", fg = "{{yellow}}" },
  { mime = "**/{audio,video}/*", fg = "{{pink}}" },
  { mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{red}}" },
  { mime = "**/application/{pdf,doc,rtf}", fg = "{{sky}}" },
  { url = "*", is = "orphan", bg = "{{red}}" },
  { url = "*", is = "exec", fg = "{{green}}" },
  { url = "*/", fg = "{{blue}}" },
]
