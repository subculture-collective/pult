colourful: true
filekinds:
  normal:
    foreground: "{{text}}"
  directory:
    foreground: "{{blue}}"
    is_bold: true
  symlink:
    foreground: "{{sky}}"
  pipe:
    foreground: "{{overlay1}}"
  block_device:
    foreground: "{{red}}"
  char_device:
    foreground: "{{red}}"
  socket:
    foreground: "{{pink}}"
  special:
    foreground: "{{mauve}}"
  executable:
    foreground: "{{green}}"
    is_bold: true
  mount_point:
    foreground: "{{sapphire}}"
perms:
  user_read:
    foreground: "{{yellow}}"
  user_write:
    foreground: "{{red}}"
  user_execute_file:
    foreground: "{{green}}"
  user_execute_other:
    foreground: "{{green}}"
  group_read:
    foreground: "{{yellow}}"
  group_write:
    foreground: "{{red}}"
  group_execute:
    foreground: "{{green}}"
  other_read:
    foreground: "{{yellow}}"
  other_write:
    foreground: "{{red}}"
  other_execute:
    foreground: "{{green}}"
  special_user_file:
    foreground: "{{mauve}}"
  special_other:
    foreground: "{{overlay2}}"
  attribute:
    foreground: "{{subtext0}}"
size:
  major:
    foreground: "{{subtext1}}"
  minor:
    foreground: "{{subtext0}}"
  number_byte:
    foreground: "{{subtext1}}"
  number_kilo:
    foreground: "{{teal}}"
  number_mega:
    foreground: "{{sapphire}}"
  number_giga:
    foreground: "{{mauve}}"
  number_huge:
    foreground: "{{red}}"
  unit_byte:
    foreground: "{{overlay2}}"
  unit_kilo:
    foreground: "{{teal}}"
  unit_mega:
    foreground: "{{sapphire}}"
  unit_giga:
    foreground: "{{mauve}}"
  unit_huge:
    foreground: "{{red}}"
users:
  user_you:
    foreground: "{{peach}}"
  user_root:
    foreground: "{{red}}"
  user_other:
    foreground: "{{lavender}}"
  group_yours:
    foreground: "{{peach}}"
  group_other:
    foreground: "{{overlay1}}"
  group_root:
    foreground: "{{red}}"
links:
  normal:
    foreground: "{{sky}}"
  multi_link_file:
    foreground: "{{sapphire}}"
git:
  new:
    foreground: "{{green}}"
  modified:
    foreground: "{{yellow}}"
  deleted:
    foreground: "{{red}}"
  renamed:
    foreground: "{{teal}}"
  typechange:
    foreground: "{{mauve}}"
  ignored:
    foreground: "{{overlay0}}"
  conflicted:
    foreground: "{{maroon}}"
git_repo:
  branch_main:
    foreground: "{{text}}"
  branch_other:
    foreground: "{{mauve}}"
  git_clean:
    foreground: "{{green}}"
  git_dirty:
    foreground: "{{red}}"
punctuation:
  foreground: "{{overlay1}}"
date:
  foreground: "{{teal}}"
inode:
  foreground: "{{subtext0}}"
blocks:
  foreground: "{{overlay2}}"
header:
  foreground: "{{text}}"
  is_bold: true
octal:
  foreground: "{{teal}}"
flags:
  foreground: "{{mauve}}"
symlink_path:
  foreground: "{{sky}}"
control_char:
  foreground: "{{peach}}"
broken_symlink:
  foreground: "{{red}}"
broken_path_overlay:
  foreground: "{{surface2}}"
